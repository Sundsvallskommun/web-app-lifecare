    "@typescript-eslint/parser": "^8.72.0",
    "cross-env": "^7.0.3",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "husky": "^8.0.3",
    "lint-staged": "^13.2.2",
    "node-config": "^0.0.2",
    "nodemon": "^3.1.0",
    "prettier": "^3.2.5",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.8",
